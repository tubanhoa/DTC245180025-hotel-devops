SEED_STAFF_PASSWORD=your_seed_staff_password
SEED_CUSTOMER_PASSWORD=your_seed_customer_password
GRAFANA_ADMIN_PASSWORD=example_grafana_secret
EXPORTER_PASSWORD=example_exporter_secret
