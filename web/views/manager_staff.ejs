<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div style="margin-bottom: 1.5rem;">
  <h2 style="color: var(--primary);">Quản Lý Nhân Sự & Tài Khoản</h2>
  <p style="color: var(--text-muted);">Tạo mới tài khoản lễ tân, quản lý và phân quyền nhân viên khách sạn.</p>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div style="display: grid; grid-template-columns: 340px 1fr; gap: 1.5rem;">
  <div style="background: #fff; padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow); height: fit-content;">
    <h3 style="color: var(--primary); margin-bottom: 1rem;">➕ Thêm Nhân Viên Mới</h3>
    <form action="/manager/staff" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="margin-bottom: 0.75rem;">
        <label style="font-weight: 600;">Họ và tên *</label>
        <input type="text" name="full_name" required placeholder="Lê Văn B">
      </div>
      <div style="margin-bottom: 0.75rem;">
        <label style="font-weight: 600;">Tên đăng nhập *</label>
        <input type="text" name="username" required placeholder="letan03">
      </div>
      <div style="margin-bottom: 0.75rem;">
        <label style="font-weight: 600;">Email *</label>
        <input type="email" name="email" required placeholder="letan03@hotel.local">
      </div>
      <div style="margin-bottom: 0.75rem;">
        <label style="font-weight: 600;">Số điện thoại</label>
        <input type="text" name="phone" placeholder="09xxxxxxxx">
      </div>
      <div style="margin-bottom: 0.75rem;">
        <label style="font-weight: 600;">Vai trò *</label>
        <select name="role">
          <option value="staff">Nhân viên Lễ tân (staff)</option>
          <option value="manager">Quản lý Khách sạn (manager)</option>
        </select>
      </div>
      <div style="margin-bottom: 1rem;">
        <label style="font-weight: 600;">Mật khẩu ban đầu *</label>
        <input type="password" name="password" required value="Staff123@">
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Tạo Tài Khoản</button>
    </form>
  </div>

  <div class="table-container" style="margin-top: 0;">
    <table>
      <thead>
        <tr>
          <th>Họ tên</th>
          <th>Tài khoản</th>
          <th>Vai trò</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% staffList.forEach(s => { %>
          <tr>
            <td>
              <strong><%= s.full_name %></strong><br>
              <small style="color: var(--text-muted);"><%= s.email %></small>
            </td>
            <td><code><%= s.username %></code></td>
            <td><span class="badge <%= s.role === 'manager' ? 'badge-confirmed' : 'badge-checked_in' %>"><%= s.role %></span></td>
            <td>
              <span class="badge <%= s.is_active ? 'badge-available' : 'badge-maintenance' %>">
                <%= s.is_active ? 'Hoạt động' : 'Đã khóa' %>
              </span>
            </td>
            <td>
              <% if (s.id === currentUserId) { %>
                <span style="font-size: 0.85rem; color: var(--text-muted);">Đang đăng nhập (Không thể khóa)</span>
              <% } else { %>
                <form action="/manager/staff/<%= s.id %>/toggle-active" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm <%= s.is_active ? 'btn-danger' : 'btn-success' %>">
                    <%= s.is_active ? 'Khóa Tài Khoản' : 'Mở Khóa' %>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
